{
  "name": "teamflow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Team Flow 网页（本地试用版）：构建产物输出到 server/teamflow_server/web_dist/，随仓库提交，运行时不需要 Node。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "shots": "node e2e/run.mjs --shots"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "27.4.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
